# TX-Node Configuration
# Xboard-compatible panel settings are preserved as a protocol compatibility layer.
# Top-level settings are inherited by all instances. Instance overrides take precedence.

# ── Single node (simplest) ──
# panel:
#   url: "https://panel.example.com"
#   token: "your-api-key"
#   node_id: 1

# ── Multiple instances ──
# kernel:
#   type: "singbox"
# log:
#   level: "info"
# instances:
#   - panel:
#       url: "https://panel.example.com"
#       token: "api-key-1"
#       node_id: 1
#   - panel:
#       url: "https://panel.example.com"
#     machine:
#       machine_id: 2
#       token: "machine-token-2"
#     log:
#       level: "debug"   # override for this instance only

# ── TX-Node extension: sing-box access audit (optional, disabled by default) ──
# Requires the AccessAudit panel plugin (v2.1+). Reporting reuses
# panel.url/token/node_id and the same ServerV2 authentication used by node reports.
#
# ⚠️ report_all=false only reports connections that match an enabled rule.
#    No enabled rules = no audit events are reported.
#    → matched records only: report_all: false + at least one enabled panel rule
#    → full access logs:      report_all: true
#
# audit:
#   enabled: true
#   report_all: false     # true = report every connection (high volume)
#   batch_max: 50        # max events per request (report_all default: 200)
#   flush_interval: 15   # report interval in seconds
#   rules_refresh: 5     # rule refresh interval in minutes
#   queue_cap: 5000      # local queue cap while the panel is unavailable
#                        # report_all default: 50000; overflow is counted + warned
#
# Upper send-rate bound = batch_max × 10 / flush_interval events/sec.
# Review panel capacity before enabling report_all; see README capacity guidance.
